# Caddy is the only thing the outside world talks to (docs/DEPLOY.md).
#   /api/*  and  /ws*  -> the gateway (WebSockets are forwarded automatically)
#   everything else    -> the website's files; unknown paths get index.html so page links work
#
# This demo listens on plain http. For a real domain, replace ":80" with the domain name and Caddy
# gets and renews an HTTPS certificate by itself.
{
	# No access log is switched on here on purpose: the WebSocket address carries the login token
	# (docs/AUTH.md section 2.5), and an access log would write it down.
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	@gateway path /api/* /ws /ws/* /health
	handle @gateway {
		reverse_proxy gateway:8080
	}

	# File names under /assets contain a hash of their content, so they can be cached for good.
	# A missing one is a plain 404: it must never be answered with the home page.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is a page of the website. Unknown paths get index.html so links like
	# /markets/1 work when typed in. The home page itself is never cached, so a new release shows up.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}